# Copy to .env and fill in real values — never commit .env
DB_HOST=localhost
DB_PORT=8889
DB_USER=poscafe
DB_PASSWORD=changeme
DB_NAME=poscafe

SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=480
WHATSAPP_NUMBER=97300000000

# Transactional email (SMTP SSL, typically port 465)
MAIL_HOST=
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=N Designs
# Where admin new-order alerts are sent. Leave blank to use MAIL_FROM_ADDRESS.
ADMIN_NOTIFICATION_EMAIL=
# Public origin used in email links (no trailing slash)
SITE_URL=http://127.0.0.1:8000
